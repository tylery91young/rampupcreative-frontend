{
  "name": "rampupcreative-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Ramp Up Creative — static site (Cloudflare Pages) + Pages Functions + D1",
  "scripts": {
    "build": "python scripts/build.py",
    "serve": "python scripts/serve.py",
    "predev": "python scripts/build.py",
    "dev": "wrangler pages dev dist --compatibility-date=2024-11-01",
    "db:local": "wrangler d1 execute rampupcreative --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute rampupcreative --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
